# clannon-wake@<side>.path — watch one proposal inbox, trigger the wake service.
# Instances: clannon-wake@backend.path (watches proposals/to-backend/),
#            clannon-wake@frontend.path (watches proposals/to-frontend/).
# PathModified fires on create/write/move in the directory; the service script
# re-scans and filters (dotfiles/swap ignored, archive-moves find nothing
# pending, 60s debounce), so coarse events are fine. conversations/ and
# archive/ are deliberately NOT watched — proposals are the signal.
# Install: copy (with clannon-wake@.service) to ~/.config/systemd/user/ and
#   systemctl --user daemon-reload && systemctl --user enable --now clannon-wake@{backend,frontend}.path

[Unit]
Description=Clannon %i agent wake — watch proposals/to-%i/

[Path]
PathModified=%h/Vault/projects/Clannon/proposals/to-%i
Unit=clannon-wake@%i.service

[Install]
WantedBy=default.target
