# clannon-heartbeat@<side>.timer — POLL the coordinator's keep-alive so the agent
# never sleeps permanently. The paired clannon-heartbeat.sh does the real decision:
# for the BACKEND it is idle-gated — it nudges the coordinator only when ALL
# specialists (memory + orchestration) are idle (once per idle period), plus a 1h
# safety fallback. So the timer polls often and CHEAPLY (just a couple of tmux
# capture-pane reads); the script suppresses all but the meaningful nudge. This is
# the EXTERNAL guarantee the inbox-triggered clannon-wake@<side>.path can't give (a
# quiet inbox would let an idle agent sleep forever); independent of the agent's own
# ScheduleWakeup; survives a session restart / crash / reboot.
#
# Instances: clannon-heartbeat@backend.timer is the ONLY one meant for this cadence
# (the coordinator is the hub — if it sleeps the whole team stalls). The fast poll +
# idle-gate logic is backend-specific; do NOT enable a specialist instance on this
# template (its `*` branch is an un-gated plain keep-alive — a 2-min tick would spam
# it). A specialist that should self-nudge wants its own slow (~20-30min) override.
#
# Install (or let scripts/clannon-standup.sh do it idempotently on resume):
#   cp scripts/systemd/clannon-heartbeat@.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now clannon-heartbeat@backend.timer

[Unit]
Description=Clannon %i heartbeat timer — idle-gated coordinator poll (~2 min)

[Timer]
# First tick 2 min after enable/boot (so a just-woken crew settles), then poll every
# 2 min from the last run — the script fires a nudge only when the specialists are all
# idle (or the 1h fallback), so the frequent poll is how the coordinator learns
# "they went idle" within ~2 min rather than up to 20. Monotonic (not wall-clock) so
# it keeps cadence across suspend/resume without piling up missed runs.
OnActiveSec=2min
OnUnitActiveSec=2min
AccuracySec=20s
Unit=clannon-heartbeat@%i.service

[Install]
WantedBy=timers.target
