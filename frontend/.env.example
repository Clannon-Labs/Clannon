# Clannon frontend environment
# Copy to .env.local and adjust. All values are PUBLIC (bundled into
# the client) — never put secrets in NEXT_PUBLIC_* variables.
#
# Env vars cover the values that differ per environment (dev/staging/
# prod). Everything else changeable lives in src/config/ — see the
# "Configuration map" section of README.md for the full list.

# ---- API ----------------------------------------------------------
# "http" = real backend (safe default; also used when this variable is absent)
# "mock" = bundled pipeline simulator (explicit local/demo opt-in only)
NEXT_PUBLIC_API_MODE=http

# Base URL of the FastAPI backend (used when API_MODE=http).
# Endpoint paths under this URL are defined in src/config/app.config.ts
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Site ---------------------------------------------------------
# Public origin of THIS frontend (canonical URLs, OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact addresses shown in the UI and legal documents
# (defaults live in src/config/site.config.ts)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# NEXT_PUBLIC_PRIVACY_EMAIL=privacy@yourdomain.com
# NEXT_PUBLIC_LEGAL_EMAIL=legal@yourdomain.com
