# CLANNON PRODUCTION FRONTEND REFERENCE.
# Next does not load `.env.prod`; upload these values to the production build
# environment. Production remains HTTP-backed when API_MODE is absent.
# All NEXT_PUBLIC_* values are browser-visible; never add secrets here.

NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_BASE_URL=https://api.clannon.com
NEXT_PUBLIC_SITE_URL=https://clannon.com

# Required before enabling real users:
# - DNS `api.clannon.com` must point to the deployed backend.
# - Backend CORS must allow exactly `https://clannon.com`.
# - Backend cookies must be Secure and scoped to `.clannon.com`.
#
# Keep NEXT_PUBLIC_APP_URL unset while marketing site and workspace both live
# at `https://clannon.com`. No values should have a trailing slash.
