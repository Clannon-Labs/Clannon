# ANTHROPIC_API_KEY=your_key_here

# OPENAI_API_KEY=your_key_here

# GOOGLE_API_KEY=your_key_here
# # Extra Google keys from separate accounts (separate free-tier quotas) — the
# # system rotates to the next key when one account's quota runs out. Number
# # them contiguously: _2, _3, ...
# GOOGLE_API_KEY_2=your_key_here
# GOOGLE_API_KEY_3=your_key_here

# XAI_API_KEY=your_key_here

# OPENROUTER_API_KEY=your_key_here

# MISTRAL_API_KEY=your_key_here

# AWS_BEARER_TOKEN_BEDROCK=your_key_here
# # or:
# AWS_ACCESS_KEY_ID=your_key_here
# AWS_SECRET_ACCESS_KEY=your_key_here

# CEREBRAS_API_KEY=your_key_here

# # Cohere
# CO_API_KEY=your_key_here

# GROQ_API_KEY=your_key_here

# OLLAMA_BASE_URL='http://localhost:11434/v1'
# OLLAMA_API_KEY=your_key_here  # required for Ollama Cloud

# # To use hugging face models' api
# HF_TOKEN=your_hugging_face_key_here #Also for downloading a very small model for memory management (if not already in the repo)

# GITHUB_TOKEN=your_key_here #for slop detector expert/skill

# Security scanners
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
AGENT_YARA_DIR=rules

# Memory / vector store
# QDRANT_URL=http://localhost:6333
# VRAKSHA_EMBED_CACHE=./assets/fastembed_cache    # baked into the Docker image; set for local dev

# Sandbox (expert code execution) — OFF unless enabled
# VRAKSHA_ENABLE_SANDBOX=1
# VRAKSHA_SANDBOX_IMAGE=vraksha-sandbox:latest

# API server
# FRONTEND_ORIGIN=http://localhost:3000           # CORS allow-origin (the Vercel URL in prod)
# SERVER_CORS_ORIGINS=http://localhost:3000       # comma-separated exact origins; never "*" with cookies
# SERVER_COOKIE_SECURE=0                          # production: 1
# SERVER_COOKIE_DOMAIN=                           # production: .clannon.com; blank keeps local host-only cookie
# SERVER_DEFAULT_PLAN=free                        # private alpha: use pro only if all testers should get full gates
# SERVER_DB_PATH=./api/data/clannon.db            # SQLite for dev; Supabase/Postgres in prod
# MAX_REQUEST_BODY_BYTES=33554432

# Environment hardening
# VRAKSHA_ENV=development                         # production: production
# CLANNON_STRICT_CONFIG=0                         # production: 1
# AGENT_REQUIRE_YARA=0                            # production: 1

# Persistent local stores
# VRAKSHA_GRAPH_DB_PATH=./core/memory/data
# VRAKSHA_ARTIFACTS_DIR=./api/data/artifacts

# Hardened prompt overlay (out-of-git). Auto-discovered as ./prompts.secure, or:
# VRAKSHA_PROMPTS_DIR=/path/to/prompts.secure
# VRAKSHA_REQUIRE_PROD_PROMPTS=1                  # prod: fail closed if a locked prompt is still on its baseline

# Production upload template: .env.prod (gitignored; replace every REPLACE_*).
